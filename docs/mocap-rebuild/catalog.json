      "id": "raw",
      "label": "Raw recovery",
      "description": "Unfiltered recovered motion; one constant calibration, original source timing. Not a closed loop."
    },
    {
      "id": "cleaned",
      "label": "Cleaned recovery",
      "description": "Modest local quaternion/root filtering; exactly the raw control ground calibration. Original source timing; not a closed loop."
    },
    {
      "id": "single",
      "label": "MotionBricks / single poses",
      "description": "Genuine SOMA neural in-betweening through individual cleaned source landmarks, with generated entry/return and authored neutral holds."
    },
    {
      "id": "window",
      "label": "MotionBricks / motion windows",
      "description": "Same landmarks, four consecutive target poses around each arrival; neural entry/return and authored neutral holds."
    }
  ],
